<% if @issue && !@issue.closed? %>
  <% closed_status = IssueStatus.where(is_closed: true).order(:position).first %>
  <% if closed_status && @issue.new_statuses_allowed_to(User.current).include?(closed_status) %>
    <div id="fast-close-hook">
      <%= form_tag(fast_close_issue_path(@issue), method: :post) do %>
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <%= submit_tag l(:button_fast_close), class: 'icon icon-close fast-close-btn', data: { confirm: l(:text_confirm_close) } %>
      <% end %>
    </div>

    <script>
      (function() {
        var hook = document.getElementById('fast-close-hook');
        if (!hook) return;

        var form = hook.querySelector('form');
        var contextual = document.querySelector('div.issue div.contextual') ||
                         document.querySelector('.issue .contextual');

        if (contextual && form) {
          contextual.appendChild(form);
          hook.remove();
        }
      })();
    </script>

    <style>
      .fast-close-btn {
        padding: 2px 8px !important;
        margin-left: 4px;
        background-color: #b22222;
        color: #fff !important;
        border: 1px solid #8b0000;
        border-radius: 3px;
        cursor: pointer;
        font-size: 0.9em;
      }
      .fast-close-btn:hover {
        background-color: #8b0000;
      }
    </style>
  <% end %>
<% end %>
