<% if @issue && !@issue.closed? %>
  <% closed_status = IssueStatus.where(is_closed: true).order(:position).first %>
  <% if closed_status && @issue.new_statuses_allowed_to(User.current).include?(closed_status) %>
    <div id="fast-close-hook">
      <%= link_to l(:button_fast_close), fast_close_issue_path(@issue), method: :post, class: 'icon icon-close' %>
    </div>

    <script>
      (function() {
        var hook = document.getElementById('fast-close-hook');
        if (!hook) return;

        var link = hook.querySelector('a');
        var issueH2 = document.querySelector('div.issue h2');
        var contextual = document.querySelector('div.issue div.contextual') ||
                         document.querySelector('.issue .contextual');

        if (!contextual && issueH2) {
          contextual = document.createElement('div');
          contextual.className = 'contextual';
          issueH2.parentNode.insertBefore(contextual, issueH2);
        }

        if (contextual && link) {
          contextual.appendChild(link);
          hook.remove();
        }
      })();
    </script>
  <% end %>
<% end %>
